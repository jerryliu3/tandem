# SimpleFIN access URL, claimed once from a setup token:
#   curl -X POST "$(printf '%s' 'PASTE_SETUP_TOKEN' | base64 -d)"
# The printed URL looks like https://user:pass@bridge.simplefin.org/simplefin
# Put it here. It never goes to the browser.
SIMPLEFIN_ACCESS_URL=

# Any long random string. Paste the same value into Months → Update balances.
SYNC_SECRET=
